# Copy to .env (gitignored) and fill in real values before running
# docker compose up. Never commit the real team ID/bundle ID pairing here —
# it's not secret, but there's no reason to make it easy to enumerate.
APPATTEST_TEAM_ID=XXXXXXXXXX
# One bundle id, or several comma-separated. More than one is for
# development only (the app plus its test harness); production lists the
# shipped app alone.
APPATTEST_BUNDLE_ID=com.example.SecureChat
APPATTEST_ENVIRONMENT=development
